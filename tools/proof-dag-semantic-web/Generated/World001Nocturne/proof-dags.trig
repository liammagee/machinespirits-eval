<https://machinespirits.org/derivation/world/world_001_nocturne/rule/R1_watermark_dating> a prov:Plan, ms:HornRule;
    rdfs:label "A leaf carries its mill's watermark; if a paper stock was in the copy-room only during one period, whatever is written on that stock was written there in that period.";
    ms:antecedentJson "[[\"watermark\",\"?w\",\"?stock\"],[\"stockUsedOnlyDuring\",\"?stock\",\"?period\"]]"^^rdf:JSON;
    ms:consequentJson "[[\"writtenDuring\",\"?w\",\"?period\"]]"^^rdf:JSON;
    ms:ruleId "R1_watermark_dating".
<https://machinespirits.org/derivation/world/world_001_nocturne/rule/R1a_ink_dating> a prov:Plan, ms:HornRule;
    rdfs:label "Ink betrays its batch; if a work's ink was mixed only during one period, the work was written in that period.";
    ms:antecedentJson "[[\"inkOf\",\"?w\",\"?batch\"],[\"batchMixedOnlyDuring\",\"?batch\",\"?period\"]]"^^rdf:JSON;
    ms:consequentJson "[[\"writtenDuring\",\"?w\",\"?period\"]]"^^rdf:JSON;
    ms:ruleId "R1a_ink_dating".
<https://machinespirits.org/derivation/world/world_001_nocturne/rule/R2_presence> a prov:Plan, ms:HornRule;
    rdfs:label "Whoever was at the conservatory during the period a work was written there could have written it; no one writes in a room they never entered.";
    ms:antecedentJson "[[\"writtenDuring\",\"?w\",\"?period\"],[\"atConservatoryDuring\",\"?x\",\"?period\"]]"^^rdf:JSON;
    ms:consequentJson "[[\"couldHaveWritten\",\"?x\",\"?w\"]]"^^rdf:JSON;
    ms:ruleId "R2_presence".
<https://machinespirits.org/derivation/world/world_001_nocturne/rule/R2a_ledger_presence> a prov:Plan, ms:HornRule;
    rdfs:label "The copy-room ledger does not lie: whoever signed it through a period was at the conservatory then.";
    ms:antecedentJson "[[\"signedLedger\",\"?x\",\"?period\"]]"^^rdf:JSON;
    ms:consequentJson "[[\"atConservatoryDuring\",\"?x\",\"?period\"]]"^^rdf:JSON;
    ms:ruleId "R2a_ledger_presence".
<https://machinespirits.org/derivation/world/world_001_nocturne/rule/R3_source_access> a prov:Plan, ms:HornRule;
    rdfs:label "If a work quotes a tune that was kept within one house's walls — never printed, never performed — then whoever dwelled within those walls had the source of the work.";
    ms:antecedentJson "[[\"quotes\",\"?w\",\"?m\"],[\"heardOnlyWithin\",\"?m\",\"?place\"],[\"dwelledIn\",\"?x\",\"?place\"]]"^^rdf:JSON;
    ms:consequentJson "[[\"hadSourceOf\",\"?x\",\"?w\"]]"^^rdf:JSON;
    ms:ruleId "R3_source_access".
<https://machinespirits.org/derivation/world/world_001_nocturne/rule/R4_attribution> a prov:Plan, ms:HornRule;
    rdfs:label "The archive attributes a work to one who could have written it, who had its source, and whose hand corrected its draft — copyists copy fair; only the composer strikes out and rewrites.";
    ms:antecedentJson "[[\"couldHaveWritten\",\"?x\",\"?w\"],[\"hadSourceOf\",\"?x\",\"?w\"],[\"draftCorrectedBy\",\"?w\",\"?x\"]]"^^rdf:JSON;
    ms:consequentJson "[[\"composed\",\"?x\",\"?w\"]]"^^rdf:JSON;
    ms:ruleId "R4_attribution"
}
