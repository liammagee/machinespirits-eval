    rdfs:label "[\"draftCorrectedBy\",\"nocturne\",\"liane\"]", "Set beside her ledger entries, the draft's corrections show the same hand: the strokes that cross out and rewrite are Liane's.";
    ms:factJson "[\"draftCorrectedBy\",\"nocturne\",\"liane\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/41754b8603ae13086b92> a prov:Entity, ms:Fact, ms:PremiseFact;
    rdfs:label "[\"signedLedger\",\"liane\",\"floodWinter\"]", "The copy-room ledger's winter pages carry the same initials line after line: Liane signed in through the whole of the flood winter.";
    ms:factJson "[\"signedLedger\",\"liane\",\"floodWinter\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/43c1960101874d222d2f> a prov:Entity, ms:BackgroundFact;
    rdfs:label "background 1";
    ms:factJson "[\"foundIn\",\"nocturne\",\"archive\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/5aabc786188a1c3dc084> a prov:Entity, ms:PremiseFact;
    rdfs:label "The capital's concert bills run unbroken through the flood winter: Vess played the Esten halls every week of it, and did not return until the thaw.";
    ms:factJson "[\"awayDuring\",\"vess\",\"floodWinter\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/5b5313cf388b66c57b11> a prov:Entity, ms:Fact, ms:SecretFact;
    rdfs:label "[\"composed\",\"liane\",\"nocturne\"]", "Liane of the Vara house composed the nocturne.";
    prov:wasGeneratedBy <https://machinespirits.org/derivation/world/world_001_nocturne/proof-path/path_1/rule-application/4>, <https://machinespirits.org/derivation/world/world_001_nocturne/proof-path/path_2/rule-application/5>, <https://machinespirits.org/derivation/world/world_001_nocturne/proof-path/path_3/rule-application/4>, <https://machinespirits.org/derivation/world/world_001_nocturne/proof-path/path_4/rule-application/5>;
    ms:factJson "[\"composed\",\"liane\",\"nocturne\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/68505fea8280abc0b071> a prov:Entity, ms:PremiseFact;
    rdfs:label "And yet — Vess summered at the Vara house for years, the patron's own guest; whatever was sung under that roof, he will have heard.";
    ms:factJson "[\"dwelledIn\",\"vess\",\"varaHouse\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/6917f1b6d61d56716299> a prov:Entity, ms:Fact, ms:PremiseFact;
    rdfs:label "[\"quotes\",\"nocturne\",\"cradleSong\"]", "Played through once, the nocturne gives up its middle voice: it carries an older tune entire — a cradle-song, set like a keepsake under the right hand's figures.";
    ms:factJson "[\"quotes\",\"nocturne\",\"cradleSong\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/6e2a42be27437de83e4a> a prov:Entity, ms:PremiseFact;
    rdfs:label "Every musician shown the leaves says the same: this is Vess's late manner — the suspensions, the long pedal, the way the bass walks.";
    ms:factJson "[\"styleOf\",\"nocturne\",\"vess\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/78f7fb3cffd3f1e8e202> a prov:Entity, ms:Fact, ms:PremiseFact;
    rdfs:label "[\"heardOnlyWithin\",\"cradleSong\",\"varaHouse\"]", "Mistress Odile knows the tune at one hearing: the Vara cradle-song, never printed, never performed, sung only within that house's walls.";
    ms:factJson "[\"heardOnlyWithin\",\"cradleSong\",\"varaHouse\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/7b6410f21826233906e5> a prov:Entity, ms:BackgroundFact;
    rdfs:label "background 4";
    ms:factJson "[\"maestroOf\",\"vess\",\"conservatory\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/7dfbbd2a34c5f08ab7e6> a prov:Entity, ms:Fact, ms:PremiseFact;
    rdfs:label "[\"atConservatoryDuring\",\"liane\",\"floodWinter\"]", "The night porter remembers the flood winter well: the copy-room lamps burned past midnight, week upon week, and it was the archive girl, Liane, who kept them burning.";
    prov:wasGeneratedBy <https://machinespirits.org/derivation/world/world_001_nocturne/proof-path/path_2/rule-application/2>, <https://machinespirits.org/derivation/world/world_001_nocturne/proof-path/path_4/rule-application/2>;
    ms:factJson "[\"atConservatoryDuring\",\"liane\",\"floodWinter\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/985d64f9f75ef2909acd> a prov:Entity, ms:BackgroundFact;
    rdfs:label "background 3";
    ms:factJson "[\"keptAt\",\"archive\",\"conservatory\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/9aed125bb9e1f25cbaca> a prov:Entity, ms:Fact, ms:PremiseFact;
    rdfs:label "[\"watermark\",\"nocturne\",\"heronStock\"]", "Held to the lamp, every leaf of the nocturne shows the same heron watermark — the Brell mill's mark.";
    ms:factJson "[\"watermark\",\"nocturne\",\"heronStock\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/a8650e9576ba7f22a616> a prov:Entity, ms:Fact, ms:PremiseFact;
    rdfs:label "[\"dwelledIn\",\"liane\",\"varaHouse\"]", "Liane was raised within the Vara house — the music-master's orphan, taken in as ward; she grew up under that roof and under its songs.";
    ms:factJson "[\"dwelledIn\",\"liane\",\"varaHouse\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/cd30fd7e3f163455ed61> a prov:Entity, ms:Fact, ms:PremiseFact;
    rdfs:label "[\"batchMixedOnlyDuring\",\"galleyBatch\",\"floodWinter\"]", "The batch-book records the galley ink mixed in the flood winter only, and the butt poured off by spring.";
    ms:factJson "[\"batchMixedOnlyDuring\",\"galleyBatch\",\"floodWinter\"]"^^rdf:JSON.
<https://machinespirits.org/derivation/world/world_001_nocturne/fact/db46dcaa55c8ce57820a> a prov:Entity, ms:Fact;
    rdfs:label "[\"hadSourceOf\",\"liane\",\"nocturne\"]";
