    },
    {
      "@id": "https://machinespirits.org/derivation/world/world_001_nocturne/fact/6917f1b6d61d56716299",
      "@type": [
        "ms:Fact",
        "ms:PremiseFact",
        "prov:Entity"
      ],
      "rdfs:label": [
        "[\"quotes\",\"nocturne\",\"cradleSong\"]",
        "Played through once, the nocturne gives up its middle voice: it carries an older tune entire — a cradle-song, set like a keepsake under the right hand's figures."
      ],
      "ms:factJson": [
        {
          "@value": [
            "quotes",
            "nocturne",
            "cradleSong"
          ],
          "@type": "@json"
        }
      ]
    },
    {
      "@id": "https://machinespirits.org/derivation/world/world_001_nocturne/fact/6e2a42be27437de83e4a",
      "@type": [
        "ms:PremiseFact",
        "prov:Entity"
      ],
      "rdfs:label": [
        "Every musician shown the leaves says the same: this is Vess's late manner — the suspensions, the long pedal, the way the bass walks."
      ],
      "ms:factJson": [
        {
          "@value": [
            "styleOf",
