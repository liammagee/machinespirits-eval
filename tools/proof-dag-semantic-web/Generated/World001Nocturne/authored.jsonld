    {
      "@id": "https://machinespirits.org/derivation/world/world_001_nocturne/fact/68505fea8280abc0b071",
      "@type": [
        "ms:PremiseFact",
        "prov:Entity"
      ],
      "rdfs:label": [
        "And yet — Vess summered at the Vara house for years, the patron's own guest; whatever was sung under that roof, he will have heard."
      ],
      "ms:factJson": [
        {
          "@value": [
            "dwelledIn",
            "vess",
            "varaHouse"
          ],
