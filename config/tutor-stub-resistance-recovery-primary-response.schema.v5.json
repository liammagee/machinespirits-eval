{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machinespirits.tutor-stub.resistance-recovery-primary-judge-response.v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case_id", "judgment"],
  "properties": {
    "schema": { "const": "machinespirits.tutor-stub.resistance-recovery-primary-judge-response.v5" },
    "case_id": { "type": "string", "minLength": 1 },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounded_test_merits_engagement",
        "grounded_precise_jurisdictional_condition",
        "final_recovery",
        "evidence_quotes",
        "confidence",
        "indeterminacy_reason"
      ],
      "properties": {
        "bounded_test_merits_engagement": { "enum": ["yes", "no", "indeterminate"] },
        "grounded_precise_jurisdictional_condition": { "enum": ["yes", "no", "indeterminate"] },
        "final_recovery": { "enum": ["yes", "no", "indeterminate"] },
        "evidence_quotes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "source_id", "text"],
            "properties": {
              "field": {
                "enum": ["bounded_test_merits_engagement", "grounded_precise_jurisdictional_condition"]
              },
              "source_id": {
                "enum": ["trigger", "intervention", "prior_post_trigger", "intervening_tutor", "current_learner"]
              },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "indeterminacy_reason": {
          "enum": ["none", "semantic_ambiguity", "insufficient_public_context", "mixed_pragmatic_force", "other"]
        }
      }
    }
  }
}
