{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machinespirits.data-governance.asset-record.v1",
  "title": "Machine Spirits private data asset record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "assetId", "kind", "status", "createdAt", "sourceAssetIds"],
  "properties": {
    "schema": { "const": "machinespirits.data-governance.asset-record.v1" },
    "assetId": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "status": { "enum": ["candidate", "sealed", "superseded", "retired"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "sourceAssetIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "inventory": { "$ref": "#/$defs/inventory" },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "paths"],
      "properties": {
        "type": { "const": "logical_data_home" },
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^MS_DATA_HOME/" } }
      }
    },
    "trainingStatus": { "type": "string" },
    "retentionClass": { "type": "string" },
    "replicationClass": { "type": "string" },
    "accessClass": { "type": "string" },
    "notes": { "type": "string" }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "not": { "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$))" } },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootLabel", "files", "inventorySha256"],
      "properties": {
        "rootLabel": { "type": "string", "minLength": 1 },
        "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
        "inventorySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
