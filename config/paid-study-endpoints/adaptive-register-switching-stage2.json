      "arm",
      "case_id",
      "dialogueTrace",
      "learnerRubric.delta",
      "learnerRubric.first",
      "learnerRubric.last",
      "outcomeVerdict",
      "positiveOutcome",
      "profileName",
      "scenarioId",
      "turns",
      "tutorV22.overall"
    ]
  },
  "channels": {
    "conversion_fold": {
      "enabled": true,
      "implementation": "scripts/report-charisma-desire-breakthrough-matrix.js#analyzeCharismaDesireRows"
    },
    "learner_rubric": {
      "enabled": true,
      "implementation": "scripts/eval-cli.js#evaluate-learner"
    },
    "manner_presence_reader": {
      "enabled": true,
      "implementation": "services/registerMannerPresenceReader.js#readMannerPresence"
    },
    "register_rubric": {
      "enabled": true,
      "implementation": "scripts/evaluate-register-rubric.js"
    },
    "tutor_rubric": {
      "enabled": true,
      "implementation": "scripts/eval-cli.js#evaluate"
    }
  },
  "endpoints": [
    {
      "id": "conversion_adaptive_vs_router_warm",
      "role": "primary",
      "enabled": true,
      "required_channels": [
        "conversion_fold",
        "learner_rubric",
        "manner_presence_reader",
        "register_rubric",
        "tutor_rubric"
      ],
      "required_event_fields": [
