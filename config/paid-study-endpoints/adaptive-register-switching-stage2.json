{
  "schema": "machinespirits.paid-study-endpoint-contract.v1",
  "study_id": "adaptive-register-switching-stage2",
  "registration": {
    "primary_endpoint_ids": ["conversion_adaptive_vs_router_warm"]
  },
  "registered_scale": {
    "cases": 105,
    "unit": "dialogue"
  },
  "runner": {
