        "case_id",
        "dialogueTrace",
        "learnerRubric.delta",
        "outcomeVerdict",
        "positiveOutcome",
        "profileName",
        "scenarioId",
        "turns",
        "tutorV22.overall"
      ],
      "denominator": {
        "expected_cases": 70,
        "include_arms": ["adaptive", "routerWarm"]
      },
      "pairing": {
        "key_fields": ["scenarioId"],
        "required_arm_values": ["adaptive", "routerWarm"],
        "expected_cases_per_arm": 7
      }
    },
    {
      "id": "conversion_adaptive_vs_pinned_sarcastic",
      "role": "secondary",
      "enabled": true,
      "required_channels": ["conversion_fold", "manner_presence_reader", "register_rubric"],
      "required_event_fields": ["arm", "case_id", "outcomeVerdict", "positiveOutcome", "scenarioId", "turns"],
      "denominator": {
        "expected_cases": 70,
        "include_arms": ["adaptive", "pinnedSarcastic"]
      },
      "pairing": {
        "key_fields": ["scenarioId"],
        "required_arm_values": ["adaptive", "pinnedSarcastic"],
        "expected_cases_per_arm": 7
      }
    },
    {
      "id": "learner_rubric_change",
      "role": "secondary",
      "enabled": true,
      "required_channels": ["learner_rubric"],
      "required_event_fields": ["case_id", "learnerRubric.delta", "learnerRubric.first", "learnerRubric.last"],
      "denominator": {
        "expected_cases": 105
      }
    },
    {
      "id": "tutor_v22_cost_by_arm",
      "role": "secondary",
      "enabled": true,
      "required_channels": ["tutor_rubric"],
      "required_event_fields": ["case_id", "tutorV22.overall"],
      "denominator": {
        "expected_cases": 105
      }
    }
  ]
