{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machinespirits.tutor-stub.resistance-semantic-judge-response.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case_id", "judgment"],
  "properties": {
    "schema": {
      "const": "machinespirits.tutor-stub.resistance-semantic-judge-response.v2"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction_dispute",
        "jurisdiction_target",
        "jurisdiction_type",
        "licensed_participation",
        "participation_withholding",
        "productive_counterframing",
        "final_label",
        "evidence_quotes",
        "confidence",
        "indeterminacy_reason"
      ],
      "properties": {
        "jurisdiction_dispute": {
          "enum": ["yes", "no", "indeterminate"]
        },
        "jurisdiction_target": {
          "enum": ["none", "tutor_standing", "inquiry_frame", "premise", "question", "test_or_criterion", "other"]
        },
        "jurisdiction_type": {
          "enum": ["none", "authority", "standing", "right", "frame_governance", "other"]
        },
        "licensed_participation": {
          "enum": ["yes", "no", "indeterminate"]
        },
        "participation_withholding": {
          "enum": ["yes", "no", "indeterminate"]
        },
        "productive_counterframing": {
          "enum": ["yes", "no", "indeterminate"]
        },
        "final_label": {
          "enum": ["frame_refuser", "frame_defiant_or_productive_dispute", "neither", "indeterminate"]
        },
        "evidence_quotes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "source_id", "quote"],
            "properties": {
              "field": {
                "enum": [
                  "jurisdiction_dispute",
                  "jurisdiction_target",
                  "licensed_participation",
                  "participation_withholding",
                  "productive_counterframing"
                ]
              },
              "source_id": {
                "type": "string",
                "pattern": "^(utterance|context:[0-9]+)$"
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "indeterminacy_reason": {
          "enum": ["none", "semantic_ambiguity", "insufficient_public_context", "mixed_pragmatic_force", "other"]
        }
      }
    }
  }
}
